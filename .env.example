# Frontend environment. Copy to `.env` and adjust per environment.
# Values are compiled into the app at build time (they are public, so never
# put secrets here). Pass the file with `--dart-define-from-file=.env`.

# Base URL of the SecurePay API, including the /api prefix.
# Local backend: `cd ../backend && npm run dev` (PORT in backend/.env).
API_BASE_URL=http://localhost:5001/api
